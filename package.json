{
  "name": "toolboxlab",
  "version": "1.0.0",
  "private": true,
  "description": "ToolboxLab - 纯前端本地工具集，所有数据仅在本地处理",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.js && node scripts/prerender.mjs",
    "build:prod": "vite build --mode production && node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "validate:analytics": "node scripts/validate-analytics.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:tools": "node scripts/verify-tools.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^10.11.1",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "croner": "^8.1.2",
    "diff": "^5.2.0",
    "dompurify": "^3.4.14",
    "exifr": "^7.1.3",
    "frappe-gantt": "^1.2.2",
    "gifenc": "^1.0.3",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.0",
    "jsbarcode": "^3.12.3",
    "jsonpath-plus": "^10.4.0",
    "katex": "^0.18.6",
    "mammoth": "^1.12.2",
    "marked": "^12.0.2",
    "mathjs": "^12.4.3",
    "mermaid": "^11.17.2",
    "mind-elixir": "^4.6.2",
    "opencc-js": "^1.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.2.67",
    "qrcode": "^1.5.4",
    "railroad-diagrams": "^1.0.0",
    "regexp-tree": "^0.1.27",
    "smol-toml": "^1.8.0",
    "sql-formatter": "^15.8.2",
    "terser": "^5.51.2",
    "turndown": "^7.2.4",
    "tweetnacl": "^1.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
