.env
.env.local
.env.*.local
*.local

# ── 缓存与覆盖率 ──────────────────────────────
.eslintcache
.stylelintcache
.cache/
coverage/
.nyc_output/

# ── 日志 ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── 编辑器 / IDE ─────────────────────────────
.vscode/
.idea/
.fleet/
.vs/
.history/
*.swp
*.swo
*.swn
*~
*.orig

